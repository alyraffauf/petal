#!/usr/bin/env bash
# Replay regressions, then give each native Go fuzz target a separate budget.
set -euo pipefail
cd "$(dirname "$0")/.."
export CGO_ENABLED="${CGO_ENABLED:-0}"
go test ./...
packages=$(go list ./...)
count=0
for package in $packages; do
  targets=$(go test -list '^Fuzz' "$package")
  while IFS= read -r target; do
    [[ $target =~ ^Fuzz[[:alnum:]_]+$ ]] || continue
    ((count+=1))
    echo "Fuzzing $package/$target"
    go test -run '^$' -fuzz "^$target$" -fuzztime "${FUZZ_TIME:-5s}" -parallel "${FUZZ_WORKERS:-2}" "$package"
  done <<< "$targets"
done
if ((count == 0)); then
  echo 'No fuzz targets found.' >&2
  exit 1
fi
